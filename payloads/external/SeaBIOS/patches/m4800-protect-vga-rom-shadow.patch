diff --git a/src/optionroms.c b/src/optionroms.c
index e906ab97..ce92930e 100644
--- a/src/optionroms.c
+++ b/src/optionroms.c
@@ -446,6 +446,58 @@ static void try_setup_display_other(void)
     }
 }
 
+#define INTEL_HOST_BRIDGE_BDF          0x0000
+#define INTEL_VENDOR_ID                0x8086
+#define INTEL_HASWELL_PAM1             0x81
+#define LEGACY_SHADOW_PROTECT_END      0xe0000
+
+static void
+write_protect_legacy_shadow_pam(u32 start, u32 end)
+{
+    if (pci_config_readw(INTEL_HOST_BRIDGE_BDF, PCI_VENDOR_ID) != INTEL_VENDOR_ID)
+        return;
+
+    start = ALIGN_DOWN(start, 16 * 1024);
+    end = ALIGN(end, 16 * 1024);
+    if (start < BUILD_ROM_START)
+        start = BUILD_ROM_START;
+    if (end > BUILD_BIOS_ADDR)
+        end = BUILD_BIOS_ADDR;
+    if (start >= end)
+        return;
+
+    dprintf(1, "Write-protecting legacy option ROM shadow %05x-%05x\n"
+            , start, end - 1);
+
+    u32 addr;
+    for (addr = start; addr < end; addr += 16 * 1024) {
+        u32 index = (addr - BUILD_ROM_START) / (16 * 1024);
+        u8 reg = INTEL_HASWELL_PAM1 + index / 2;
+        u8 read_enable = (index & 1) ? 0x10 : 0x01;
+        u8 write_enable = (index & 1) ? 0x20 : 0x02;
+        u8 val = pci_config_readb(INTEL_HOST_BRIDGE_BDF, reg);
+        u8 newval = (val | read_enable) & ~write_enable;
+
+        if (newval != val) {
+            dprintf(1, "PAM%u %02x -> %02x\n"
+                    , reg - 0x80, val, newval);
+            pci_config_writeb(INTEL_HOST_BRIDGE_BDF, reg, newval);
+        }
+    }
+}
+
+void
+optionrom_prepboot(void)
+{
+    u32 start = BUILD_ROM_START;
+    u32 end = rom_get_last();
+
+    if (end < LEGACY_SHADOW_PROTECT_END)
+        end = LEGACY_SHADOW_PROTECT_END;
+
+    write_protect_legacy_shadow_pam(start, end);
+}
+
 // Call into vga code to turn on console.
 void
 vgarom_setup(void)
