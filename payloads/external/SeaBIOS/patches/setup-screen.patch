+
+    if (width == 4)
+        snprintf(buf, sizeof(buf), "%04u", value);
+    else
+        snprintf(buf, sizeof(buf), "%02u", value);
+    setup_draw_value_row(row, name, buf, SETUP_ATTR_NORMAL, value_attr);
+}
+
+static void
+setup_draw_main_page(const struct setup_datetime_state *dt, int focus)
+{
+    setup_clear_page();
+    setup_draw_datetime_row(6, "System Hour", dt->hour, dt->selected == 0,
+                            focus, 2);
+    setup_draw_datetime_row(7, "System Minute", dt->min, dt->selected == 1,
+                            focus, 2);
+    setup_draw_datetime_row(8, "System Second", dt->sec, dt->selected == 2,
+                            focus, 2);
+    setup_draw_datetime_row(10, "System Month", dt->month, dt->selected == 3,
+                            focus, 2);
+    setup_draw_datetime_row(11, "System Day", dt->day, dt->selected == 4,
+                            focus, 2);
+    setup_draw_datetime_row(12, "System Year", dt->year, dt->selected == 5,
+                            focus, 4);
+    setup_footer("F1 Help  Tab Menu  F10 Save Time  ESC Reboot  Left/Right Change");
+}
+
+static void
+setup_draw_advanced_page(const struct setup_advanced_state *adv, int focus)
+{
+    /* Secondary IDE controller only exists in IDE native mode */
+    int sata2_valid = adv->sata_mode == 1;
+    u8 sata_attr = adv->selected == 0 && focus == SETUP_FOCUS_PAGE
+        ? SETUP_ATTR_SELECT : SETUP_ATTR_NORMAL;
+    u8 sata2_label_attr = sata2_valid ? SETUP_ATTR_NORMAL : SETUP_ATTR_DISABLED;
+    u8 sata2_attr = adv->selected == 1 && focus == SETUP_FOCUS_PAGE
+        ? SETUP_ATTR_SELECT : sata2_label_attr;
+    u8 hda_attr = adv->selected == 2 && focus == SETUP_FOCUS_PAGE
+        ? SETUP_ATTR_SELECT : SETUP_ATTR_NORMAL;
+    u8 turbo_attr = adv->selected == 3 && focus == SETUP_FOCUS_PAGE
+        ? SETUP_ATTR_SELECT : SETUP_ATTR_NORMAL;
+    u8 vga_attr = adv->selected == 4 && focus == SETUP_FOCUS_PAGE
+        ? SETUP_ATTR_SELECT : SETUP_ATTR_NORMAL;
+
+    setup_clear_page();
+    setup_draw_value_row(6, "SATA Mode", setup_sata_mode_name(adv->sata_mode),
+                         SETUP_ATTR_NORMAL, sata_attr);
+    setup_draw_value_row(7, "mSATA Controller", setup_sata2_name(adv->sata2),
+                         sata2_label_attr, sata2_attr);
+    setup_draw_value_row(8, "HD Audio", setup_hda_name(adv->hda_disable),
+                         SETUP_ATTR_NORMAL, hda_attr);
+    setup_draw_value_row(9, "CPU Turbo", setup_turbo_name(adv->turbo_disable),
+                         SETUP_ATTR_NORMAL, turbo_attr);
+    setup_draw_value_row(10, "CPU Clock Cap", "Not implemented",
+                         SETUP_ATTR_DISABLED, SETUP_ATTR_DISABLED);
+    setup_draw_value_row(11, "Hyperthreading", "Not implemented",
+                         SETUP_ATTR_DISABLED, SETUP_ATTR_DISABLED);
+    setup_draw_value_row(12, "VGA Mux", setup_vga_mux_name(adv->vga_mux),
+                         SETUP_ATTR_NORMAL, vga_attr);
+    setup_footer("F1 Help  Tab Menu  F9 Defaults  F10 Save  ESC Reboot  Left/Right Change");
+}
+
+static void
+setup_draw_3dfx_row(u8 row, const char *name, const char *value, u8 attr)
+{
+    setup_draw_value_row(row, name, value,
+                         attr == SETUP_ATTR_DISABLED ? SETUP_ATTR_DISABLED : SETUP_ATTR_NORMAL,
+                         attr);
+}
+
+static void
+setup_draw_3dfx_page(const struct setup_3dfx_state *mxm, int focus)
+{
+    char value[24];
+    u8 brightness_attr = mxm->selected == 0 && focus == SETUP_FOCUS_PAGE
+        ? SETUP_ATTR_SELECT : SETUP_ATTR_NORMAL;
+    u8 vcore_attr = mxm->selected == 1 && focus == SETUP_FOCUS_PAGE
+        ? SETUP_ATTR_SELECT : SETUP_ATTR_NORMAL;
+    u8 fb_attr = mxm->m4800
+        ? (mxm->selected == 2 && focus == SETUP_FOCUS_PAGE
+           ? SETUP_ATTR_SELECT : SETUP_ATTR_NORMAL)
+        : SETUP_ATTR_DISABLED;
+    u8 blank_fix_attr = mxm->m4800
+        ? (mxm->selected == 3 && focus == SETUP_FOCUS_PAGE
+           ? SETUP_ATTR_SELECT : SETUP_ATTR_NORMAL)
+        : SETUP_ATTR_DISABLED;
+
+    setup_clear_page();
+
+    if (!mxm->present) {
+        setup_draw_3dfx_row(8, "Card", mxm->model, SETUP_ATTR_DISABLED);
+        setup_footer("F1 Help  Tab Menu  F9 Defaults  F10 Apply  ESC Reboot");
+        return;
+    }
+
+    setup_draw_3dfx_row(6, "Card Model", mxm->model, SETUP_ATTR_DISABLED);
+    setup_draw_3dfx_row(7, "GPU Model", setup_3dfx_gpu_name(mxm), SETUP_ATTR_DISABLED);
+    setup_draw_3dfx_row(8, "Card Revision", mxm->revision, SETUP_ATTR_DISABLED);
+    setup_3dfx_vbios_revision(value, sizeof(value));
+    setup_draw_3dfx_row(9, "VBIOS Revision", value, SETUP_ATTR_DISABLED);
+    setup_draw_3dfx_row(10, "Display Type", mxm->display, SETUP_ATTR_DISABLED);
+    setup_draw_3dfx_row(11, "PCI Bus Speed", setup_3dfx_pci_speed_name(mxm),
+                         SETUP_ATTR_DISABLED);
+
+    snprintf(value, sizeof(value), "%u %%", mxm->brightness);
+    setup_draw_3dfx_row(13, "Panel Backlight", value, brightness_attr);
+    snprintf(value, sizeof(value), "%u.%u0 V", (mxm->vcore_code + 25) / 10,
+             (mxm->vcore_code + 25) % 10);
+    setup_draw_3dfx_row(14, "Core Voltage", value, vcore_attr);
+    setup_draw_3dfx_row(15, "Framebuffer Memory", setup_3dfx_fb_name(mxm), fb_attr);
+    setup_draw_3dfx_row(16, mxm->m4800 ? "VSA NT Blank Fix" : "Avenger Blank Fix",
+                         setup_3dfx_vsa_blank_fix_name(mxm), blank_fix_attr);
+
+    snprintf(value, sizeof(value), "%u C", mxm->gpu_temp);
+    setup_draw_3dfx_row(18, "GPU Temperature", value, SETUP_ATTR_DISABLED);
+    snprintf(value, sizeof(value), "%u C", mxm->smc_temp);
+    setup_draw_3dfx_row(19, "SMC Temperature", value, SETUP_ATTR_DISABLED);
+    snprintf(value, sizeof(value), "%u %%", mxm->fan_speed);
+    setup_draw_3dfx_row(20, "Fan Speed", value, SETUP_ATTR_DISABLED);
+    setup_3dfx_raw_name(mxm, value, sizeof(value));
+    setup_draw_3dfx_row(21, "Raw Packet", value, SETUP_ATTR_DISABLED);
+
+    setup_footer("F1 Help  Tab Menu  F9 Defaults  F10 Apply  ESC Reboot  Left/Right Change");
+}
+
+static void
+setup_reboot(void)
+{
+    qemu_reboot();
+    acpi_reboot();
+    i8042_reboot();
+    pci_reboot();
+    asm volatile("int3");
+
+    for (;;)
+        ;
+}
+
+static void
+setup_draw_current_page(int menu, int focus,
+                        const struct setup_advanced_state *adv,
+                        const struct setup_boot_state *boot,
+                        const struct setup_datetime_state *dt,
+                        const struct setup_3dfx_state *mxm,
+                        const struct setup_save_exit_state *save)
+{
+    setup_draw_tabs(menu, focus);
+    if (menu == SETUP_MENU_INFO)
+        setup_draw_info_page(mxm);
+    else if (menu == SETUP_MENU_MAIN)
+        setup_draw_main_page(dt, focus);
+    else if (menu == SETUP_MENU_ADVANCED)
+        setup_draw_advanced_page(adv, focus);
+    else if (menu == SETUP_MENU_BOOT)
+        setup_draw_boot_page(boot, focus);
+    else if (menu == SETUP_MENU_3DFX)
+        setup_draw_3dfx_page(mxm, focus);
+    else
+        setup_draw_save_exit_page(save, focus);
+}
+
