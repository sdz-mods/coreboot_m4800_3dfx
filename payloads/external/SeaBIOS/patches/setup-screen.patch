+static int
+setup_3dfx_find_bridge(u16 *bdf_out)
+{
+    int bus;
+
+    for (bus = 0; bus < 256; bus++) {
+        int bdf;
+        foreachbdf(bdf, bus) {
+            if (pci_config_readw(bdf, 0x00) == MXM_XIO2001_VENDOR
+                && pci_config_readw(bdf, 0x02) == MXM_XIO2001_DEVICE) {
+                *bdf_out = bdf;
+                return 0;
+            }
+        }
+    }
+
+    return -1;
+}
