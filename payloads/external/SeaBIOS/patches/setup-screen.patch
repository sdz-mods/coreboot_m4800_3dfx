+static void
+setup_3dfx_read_settings(struct setup_3dfx_state *mxm)
+{
+    u8 packet[5];
+    int bit;
+
+    if (!mxm->present)
+        return;
+
+    memset(packet, 0, sizeof(packet));
+    pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_10);
+    msleep(50);
+    pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_11);
+    msleep(200);
+
+    for (bit = 0; bit < 40; bit++) {
+        u8 data;
+        pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_10);
+        msleep(1);
+        pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_11);
+        msleep(1);
+        data = (pci_config_readb(mxm->bdf, MXM_GPIO_DATA) & 0x04) >> 2;
+        packet[bit / 8] = (packet[bit / 8] << 1) | data;
+    }
+
+    memcpy(mxm->raw, packet, sizeof(mxm->raw));
+
+    mxm->brightness = packet[0];
+    if (mxm->brightness < 10)
+        mxm->brightness = 10;
+    if (mxm->brightness > 100)
+        mxm->brightness = 100;
+
+    mxm->vcore_code = packet[1] >> 4;
+    if (mxm->vcore_code > 6)
+        mxm->vcore_code = 1;
+
+    mxm->fb64 = mxm->m4800 ? ((packet[1] >> 3) & 1) : 0;
+    mxm->vsa_blank_fix_en = mxm->m4800 ? ((packet[1] >> 2) & 1) : 1;
+    mxm->gpu_temp = packet[2];
+    mxm->smc_temp = packet[3];
+    mxm->fan_speed = packet[4];
+}
+
+static void
+setup_3dfx_send_byte(struct setup_3dfx_state *mxm, u8 packet)
+{
+    int bit;
+
+    pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_00);
+    msleep(1);
+    for (bit = 7; bit >= 0; bit--) {
+        if ((packet >> bit) & 1)
+            pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_11);
+        else
+            pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_01);
+        msleep(1);
+        pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_00);
+        msleep(1);
+    }
+}
+
+static void
+setup_3dfx_write_settings(struct setup_3dfx_state *mxm)
+{
+    u8 packet1;
+
+    if (!mxm->present)
+        return;
+
+    packet1 = (mxm->vcore_code << 4)
+        | (mxm->m4800 && mxm->fb64 ? 0x08 : 0)
+        | (mxm->m4800 && mxm->vsa_blank_fix_en ? 0x04 : 0);
+    setup_3dfx_send_byte(mxm, mxm->brightness);
+    setup_3dfx_send_byte(mxm, packet1);
+}
