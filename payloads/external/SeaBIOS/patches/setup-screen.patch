+    setup_3dfx_defaults(mxm);
+    setup_panel_defaults(mxm);
+
+    if (setup_3dfx_find_bridge(&mxm->bdf))
+        return;
+
+    pci_config_writeb(mxm->bdf, MXM_GPIO_DIR, 0x03);
+    if (pci_config_readw(mxm->bdf, 0x44) != MXM_SSVID_3DFX)
+        return;
+
+    mxm->ssid = pci_config_readw(mxm->bdf, 0x46);
+    setup_3dfx_decode_card(mxm);
+}
+
+static void
+setup_3dfx_read_settings(struct setup_3dfx_state *mxm)
+{
+    u8 packet[SETUP_READ_BYTES];
+    int bit;
+
+    if (!mxm->present)
+        return;
+
+    memset(packet, 0, sizeof(packet));
+    pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_10);
+    msleep(50);
+    pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_11);
+    msleep(200);
+
+    for (bit = 0; bit < (int)sizeof(packet) * 8; bit++) {
+        u8 data;
+        pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_10);
+        msleep(1);
+        pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_11);
+        msleep(1);
+        data = (pci_config_readb(mxm->bdf, MXM_GPIO_DATA) & 0x04) >> 2;
+        packet[bit / 8] = (packet[bit / 8] << 1) | data;
+    }
+
+    memcpy(mxm->raw, packet, sizeof(mxm->raw));
+
+    /*
+     * v2 read block (live data first). See mxm_protocol.h / the MSP
+     * monitor_update_host_response(). If the version byte does not match,
+     * leave the defaults in place rather than decoding garbage.
+     */
+    if (packet[0] != MXM_PROTO_VERSION)
+        return;
+
+    mxm->scaler_link = (packet[1] & 0x01) ? 1 : 0;
+    mxm->scaler_lock = (packet[1] & 0x02) ? 1 : 0;
+    mxm->in_width = packet[2] | ((u16)packet[3] << 8);
+    mxm->in_height = packet[4] | ((u16)packet[5] << 8);
+    mxm->gpu_temp = packet[6];
+    mxm->smc_temp = packet[7];
+    mxm->fan_speed = packet[8];
+
+    mxm->brightness = packet[9];
+    if (mxm->brightness < 10)
+        mxm->brightness = 10;
+    if (mxm->brightness > 100)
+        mxm->brightness = 100;
+
+    mxm->vcore_code = packet[10];
+    if (mxm->vcore_code > 6)
+        mxm->vcore_code = 1;
+
+    mxm->fb64 = mxm->m4800 ? (packet[11] ? 1 : 0) : 0;
+    mxm->vsa_blank_fix_en = mxm->m4800 ? (packet[12] ? 1 : 0) : 1;
+    mxm->dos43 = packet[13] ? 1 : 0;
+    /* packet[14] is the legacy sharpness slot (unused; filter owns sharpness) */
+    mxm->contrast = packet[15] > 100 ? 100 : packet[15];
+    mxm->peaking = packet[16] > 30 ? 30 : packet[16];
+    mxm->rgb_r = packet[17] > 100 ? 100 : packet[17];
+    mxm->rgb_g = packet[18] > 100 ? 100 : packet[18];
+    mxm->rgb_b = packet[19] > 100 ? 100 : packet[19];
+
+    mxm->filter_family = packet[20] < SETUP_FIR_FAM_COUNT
+        ? packet[20] : SETUP_FIR_FAM_MITCHELL;
+    {
+        int f;
+        for (f = 0; f < SETUP_FIR_FAM_COUNT; f++) {
+            mxm->filter_p1[f] = setup_fir_clamp(packet[21 + f],
+                                                setup_fir_p1_max(f));
+            mxm->filter_p2[f] = setup_fir_clamp(
+                packet[21 + SETUP_FIR_FAM_COUNT + f], setup_fir_p2_max(f));
+        }
+    }
+}
+
+static void
+setup_3dfx_send_byte(struct setup_3dfx_state *mxm, u8 packet)
+{
+    int bit;
+
+    pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, MXM_GPIO_00);
+    msleep(1);
+    for (bit = 7; bit >= 0; bit--) {
+        /*
+         * Drive the data line FIRST with the clock low, let it settle, then
+         * raise the clock so the MSP samples a stable bit on the rising edge.
+         * Raising data and clock together (the old sequence) violates setup
+         * time and, across the many writes an Apply sends, occasionally clocks
+         * in a wrong bit -> frame desync -> wrong/dropped setting.
+         */
+        u8 lo = ((packet >> bit) & 1) ? MXM_GPIO_10 : MXM_GPIO_00; /* data, clk 0 */
+        u8 hi = ((packet >> bit) & 1) ? MXM_GPIO_11 : MXM_GPIO_01; /* data, clk 1 */
+
+        pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, lo);   /* set data (clk low) */
+        msleep(1);                                        /* setup time */
+        pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, hi);   /* clock rising edge */
+        msleep(1);
+        pci_config_writeb(mxm->bdf, MXM_GPIO_DATA, lo);   /* clock low, data held */
+        msleep(1);                                        /* hold time */
+    }
+}
+
+/* v2 write transaction is [index, value]; index MSB (0) selects a write */
+static void
+setup_3dfx_write_reg(struct setup_3dfx_state *mxm, u8 index, u8 value)
+{
+    setup_3dfx_send_byte(mxm, index);
+    setup_3dfx_send_byte(mxm, value);
+}
+
+/* 3dfx (card) page: core voltage, framebuffer size, blank fix */
+static void
+setup_3dfx_write_settings(struct setup_3dfx_state *mxm)
+{
+    if (!mxm->present)
+        return;
+
+    setup_3dfx_write_reg(mxm, SETUP_REG_VCORE, mxm->vcore_code);
+    if (mxm->m4800) {
+        setup_3dfx_write_reg(mxm, SETUP_REG_FBSIZE, mxm->fb64 ? 1 : 0);
+        setup_3dfx_write_reg(mxm, SETUP_REG_VSA_BLANK_FIX,
+                             mxm->vsa_blank_fix_en ? 1 : 0);
+    }
+}
+
+/*
+ * Snapshot of what the card currently holds, so an Apply only writes the
+ * registers that actually changed. Fewer XIO writes = far less chance of a
+ * bit-level desync over the slow bit-banged link. Seeded from the read at
+ * setup entry (setup_panel_baseline_set) and refreshed after each Apply.
+ */
+static struct setup_3dfx_state g_panel_applied;
+
+static void
+setup_panel_baseline_set(const struct setup_3dfx_state *mxm)
+{
+    g_panel_applied = *mxm;
+}
+
+/* Panel (scaler) page: backlight + scaler image settings (changed regs only) */
+static void
+setup_panel_write_settings(struct setup_3dfx_state *mxm)
+{
+    struct setup_3dfx_state *base = &g_panel_applied;
+    int f;
+    int touched = 0;
+
+    if (!mxm->present)
+        return;
+
+    if (mxm->brightness != base->brightness)
+        setup_3dfx_write_reg(mxm, SETUP_REG_BACKLIGHT, mxm->brightness);
+    if (mxm->dos43 != base->dos43)
+        setup_3dfx_write_reg(mxm, SETUP_REG_DOS43, mxm->dos43 ? 1 : 0);
+    /* legacy SETUP_REG_SHARPNESS is not written: it would clobber the FIR */
+    if (mxm->contrast != base->contrast)
+        setup_3dfx_write_reg(mxm, SETUP_REG_CONTRAST, mxm->contrast);
+    if (mxm->peaking != base->peaking)
+        setup_3dfx_write_reg(mxm, SETUP_REG_PEAKING, mxm->peaking);
+    if (mxm->rgb_r != base->rgb_r)
+        setup_3dfx_write_reg(mxm, SETUP_REG_RGB_R, mxm->rgb_r);
+    if (mxm->rgb_g != base->rgb_g)
+        setup_3dfx_write_reg(mxm, SETUP_REG_RGB_G, mxm->rgb_g);
+    if (mxm->rgb_b != base->rgb_b)
+        setup_3dfx_write_reg(mxm, SETUP_REG_RGB_B, mxm->rgb_b);
+
+    /*
+     * Filter params are per-family on the SMC. Push only families whose params
+     * changed (make it active, write P1/P2), then leave the SMC on the selected
+     * family. Lanczos has no params, so it is only ever set as active.
+     */
+    for (f = 0; f < SETUP_FIR_FAM_COUNT; f++) {
+        int dp1 = mxm->filter_p1[f] != base->filter_p1[f];
+        int dp2 = mxm->filter_p2[f] != base->filter_p2[f];
+
+        if (setup_fir_p1_max(f) == 0 || (!dp1 && !dp2))
+            continue;
+        setup_3dfx_write_reg(mxm, SETUP_REG_FILTER_FAMILY, f);
+        if (dp1)
+            setup_3dfx_write_reg(mxm, SETUP_REG_FILTER_P1, mxm->filter_p1[f]);
+        if (dp2 && setup_fir_p2_max(f) > 0)
+            setup_3dfx_write_reg(mxm, SETUP_REG_FILTER_P2, mxm->filter_p2[f]);
+        touched = 1;
+    }
+    if (touched || mxm->filter_family != base->filter_family)
+        setup_3dfx_write_reg(mxm, SETUP_REG_FILTER_FAMILY, mxm->filter_family);
+
+    *base = *mxm;   /* card now holds these; next Apply diffs against them */
+}
