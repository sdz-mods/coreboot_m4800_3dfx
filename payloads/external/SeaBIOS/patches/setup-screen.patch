+static int
+setup_3dfx_find_gpu(u16 *bdf_out, u16 *device_out)
+{
+    int bus;
+
+    for (bus = 0; bus < 256; bus++) {
+        int bdf;
+        foreachbdf(bdf, bus) {
+            if (pci_config_readw(bdf, PCI_VENDOR_ID) != TDFX_VENDOR_ID)
+                continue;
+            *bdf_out = bdf;
+            *device_out = pci_config_readw(bdf, PCI_DEVICE_ID);
+            return 0;
+        }
+    }
+
+    return -1;
+}
