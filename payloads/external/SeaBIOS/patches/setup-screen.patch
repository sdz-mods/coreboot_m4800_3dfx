+static void
+setup_3dfx_raw_name(const struct setup_3dfx_state *mxm, char *buf, int len)
+{
+    static const char hex[] = "0123456789abcdef";
+    int i;
+
+    memset(buf, 0, len);
+    for (i = 0; i < 5 && (i * 3 + 2) < len; i++) {
+        buf[i * 3 + 0] = hex[mxm->raw[i] >> 4];
+        buf[i * 3 + 1] = hex[mxm->raw[i] & 0x0f];
+        if (i != 4 && (i * 3 + 2) < len)
+            buf[i * 3 + 2] = ' ';
+    }
+}
