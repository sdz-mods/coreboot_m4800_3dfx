+static u64
+setup_system_memory_mb(void)
+{
+    u64 ram = 0;
+    int i;
+
+    for (i = 0; i < e820_count; i++) {
+        if (e820_list[i].type == E820_RAM)
+            ram += e820_list[i].size;
+    }
+
+    return ram >> 20;
+}
