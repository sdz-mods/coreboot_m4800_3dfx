+/* ---- scale-up FIR filter UI metadata (mirrors the apps' fir_ui.h) ---- */
+static const char *const setup_fir_family_name[SETUP_FIR_FAM_COUNT] = {
+    "Mitchell-Netravali", "Keys cubic", "Gaussian", "Lanczos-2"
+};
+
+static int
+setup_fir_p1_max(int fam)
+{
+    if (fam == SETUP_FIR_FAM_GAUSS)
+        return 24;
+    if (fam == SETUP_FIR_FAM_LANCZOS)
+        return 0;
+    return 20;                 /* Mitchell B, Keys a */
+}
+
+static int
+setup_fir_p2_max(int fam)
+{
+    return fam == SETUP_FIR_FAM_MITCHELL ? 20 : 0;
+}
+
+static const char *
+setup_fir_p1_label(int fam)
+{
+    if (fam == SETUP_FIR_FAM_KEYS)
+        return "a";
+    if (fam == SETUP_FIR_FAM_GAUSS)
+        return "Sigma";
+    return "B";
+}
+
+static int
+setup_fir_clamp(int v, int max)
+{
+    if (v < 0)
+        return 0;
+    return v > max ? max : v;
+}
+
+/* step index -> parameter value in integer hundredths */
+static int
+setup_fir_p1_x100(int fam, int idx)
+{
+    if (fam == SETUP_FIR_FAM_KEYS)
+        return -100 + idx * 5;    /* -1.00..0.00 */
+    if (fam == SETUP_FIR_FAM_GAUSS)
+        return 30 + idx * 5;      /* 0.30..1.50 */
+    return idx * 5;               /* Mitchell B 0.00..1.00 */
+}
+
+/* format e.g. -0.45 into buf (needs 7 bytes); ranges are -1.00..+1.50 */
+static void
+setup_fir_fmt(int v100, char *buf)
+{
+    int a = v100 < 0 ? -v100 : v100;
+    char *p = buf;
+
+    if (v100 < 0)
+        *p++ = '-';
+    *p++ = '0' + a / 100;
+    *p++ = '.';
+    *p++ = '0' + (a % 100) / 10;
+    *p++ = '0' + a % 10;
+    *p = '\0';
+}
