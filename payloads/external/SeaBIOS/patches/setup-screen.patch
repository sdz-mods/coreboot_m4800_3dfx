+static void
+setup_copy_line(char *dst, int dstlen, const char *src)
+{
+    int i;
+
+    for (i = 0; i < dstlen - 1 && src[i] && src[i] != '\n'; i++)
+        dst[i] = src[i];
+    dst[i] = '\0';
+}
+
+static void
+setup_cpu_brand(char *buf, int len)
+{
+    u32 regs[4];
+    u32 max_ext;
+    u32 *brand = (u32*)buf;
+    int i;
+
+    memset(buf, 0, len);
+    cpuid(0x80000000, &max_ext, &regs[1], &regs[2], &regs[3]);
+    if (max_ext < 0x80000004) {
+        strtcpy(buf, "Unknown", len);
+        return;
+    }
+
+    for (i = 0; i < 3 && (i + 1) * 16 < len; i++) {
+        cpuid(0x80000002 + i, &regs[0], &regs[1], &regs[2], &regs[3]);
+        brand[i * 4 + 0] = regs[0];
+        brand[i * 4 + 1] = regs[1];
+        brand[i * 4 + 2] = regs[2];
+        brand[i * 4 + 3] = regs[3];
+    }
+    buf[len - 1] = '\0';
+    while (*buf == ' ')
+        memmove(buf, buf + 1, strlen(buf));
+}
+
+static void
+setup_coreboot_version(char *buf, int len)
+{
+    int size;
+    char *build_info = romfile_loadfile("build_info", &size);
+    const char prefix[] = "COREBOOT_VERSION: ";
+    int i;
+
+    if (!build_info) {
+        strtcpy(buf, "Unknown", len);
+        return;
+    }
+
+    for (i = 0; i < size - sizeof(prefix); i++) {
+        if (memcmp(build_info + i, prefix, sizeof(prefix) - 1) == 0) {
+            setup_copy_line(buf, len, build_info + i + sizeof(prefix) - 1);
+            free(build_info);
+            return;
+        }
+    }
+
+    strtcpy(buf, "Unknown", len);
+    free(build_info);
+}
