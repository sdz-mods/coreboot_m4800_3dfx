+    setup_draw_value_row(6, "Panel Backlight", value, SETUP_ATTR_NORMAL, attr[0]);
+
+    setup_draw_value_row(8, "Force 4:3 for DOS modes", setup_dos43_name(mxm),
+                         SETUP_ATTR_NORMAL, attr[1]);
+
+    setup_draw_value_row(9, "Scaling Filter", setup_fir_family_name[fam],
+                         SETUP_ATTR_NORMAL, attr[2]);
+    if (setup_fir_p1_max(fam) > 0) {
+        char v1[8];
+        setup_fir_fmt(setup_fir_p1_x100(fam, mxm->filter_p1[fam]), v1);
+        snprintf(value, sizeof(value), "%s %s", setup_fir_p1_label(fam), v1);
+    } else {
+        snprintf(value, sizeof(value), "fixed kernel");
+    }
+    setup_draw_value_row(10, "Filter Parameter 1", value, SETUP_ATTR_NORMAL, attr[3]);
+    if (setup_fir_p2_max(fam) > 0) {
+        char v2[8];
+        setup_fir_fmt(mxm->filter_p2[fam] * 5, v2);
+        snprintf(value, sizeof(value), "C %s", v2);
+    } else {
+        snprintf(value, sizeof(value), "n/a");
+    }
+    setup_draw_value_row(11, "Filter Parameter 2", value, SETUP_ATTR_NORMAL, attr[4]);
+
+    snprintf(value, sizeof(value), "%u", mxm->contrast);
+    setup_draw_value_row(12, "Contrast", value, SETUP_ATTR_NORMAL, attr[5]);
+    snprintf(value, sizeof(value), "%u", mxm->peaking);
+    setup_draw_value_row(13, "Edge Enhance", value, SETUP_ATTR_NORMAL, attr[6]);
+
+    snprintf(value, sizeof(value), "%u", mxm->rgb_r);
+    setup_draw_value_row(15, "White Balance R", value, SETUP_ATTR_NORMAL, attr[7]);
+    snprintf(value, sizeof(value), "%u", mxm->rgb_g);
+    setup_draw_value_row(16, "White Balance G", value, SETUP_ATTR_NORMAL, attr[8]);
+    snprintf(value, sizeof(value), "%u", mxm->rgb_b);
+    setup_draw_value_row(17, "White Balance B", value, SETUP_ATTR_NORMAL, attr[9]);
+
+    setup_footer("F1 Help  Tab Menu  F9 Def  F10 Apply  PgUp/PgDn Ends  Left/Right Change");
+}
+
+static void
+setup_reboot(void)
+{
+    qemu_reboot();
+    acpi_reboot();
+    i8042_reboot();
+    pci_reboot();
+    asm volatile("int3");
+
+    for (;;)
+        ;
+}
+
+static void
+setup_draw_current_page(int menu, int focus,
+                        const struct setup_advanced_state *adv,
+                        const struct setup_boot_state *boot,
+                        const struct setup_datetime_state *dt,
+                        const struct setup_3dfx_state *mxm,
+                        const struct setup_save_exit_state *save)
+{
+    setup_draw_tabs(menu, focus);
+    if (menu == SETUP_MENU_INFO)
+        setup_draw_info_page(mxm);
+    else if (menu == SETUP_MENU_MAIN)
+        setup_draw_main_page(dt, focus);
+    else if (menu == SETUP_MENU_ADVANCED)
+        setup_draw_advanced_page(adv, focus);
+    else if (menu == SETUP_MENU_BOOT)
+        setup_draw_boot_page(boot, focus);
+    else if (menu == SETUP_MENU_3DFX)
+        setup_draw_3dfx_page(mxm, focus);
+    else if (menu == SETUP_MENU_PANEL)
+        setup_draw_panel_page(mxm, focus);
+    else
+        setup_draw_save_exit_page(save, focus);
+}
+
+static void
+setup_show_current_help(int menu, int focus,
+                        const struct setup_advanced_state *adv,
+                        const struct setup_boot_state *boot,
+                        const struct setup_datetime_state *dt,
+                        const struct setup_3dfx_state *mxm,
+                        const struct setup_save_exit_state *save)
+{
+    const char *title = "Setup Help";
+    const char *line1 = "Use Tab or Left/Right to change menus.";
+    const char *line2 = "Use Up/Down to select page items.";
+    const char *line3 = "F1 shows details for the selected item.";
+    const char *action = "";
+
+    if (focus == SETUP_FOCUS_PAGE) {
+        if (menu == SETUP_MENU_MAIN) {
+            title = "Date and Time";
+            line1 = "Adjusts the RTC value saved by the chipset.";
+            line2 = "Values are applied immediately after save.";
+            line3 = "";
+            action = "Press F10 on this page to save the new time.";
+        } else if (menu == SETUP_MENU_ADVANCED) {
+            if (adv->selected == 0) {
+                title = "SATA Mode";
+                line1 = "AHCI is recommended for NT-based Windows and Linux.";
+                line2 = "IDE native is recommended for Windows 98, and also";
+                line3 = "works with NT-based Windows and Linux.";
+                action = "Press F10 to save, then reboot.";
+            } else if (adv->selected == 1) {
+                title = "mSATA Controller";
+                line1 = "Exposes the second IDE controller (00:1f.5), which";
+                line2 = "carries the mSATA port. IDE native mode only.";
+                line3 = "";
+                action = "Press F10 to save, then reboot.";
+            } else if (adv->selected == 2) {
+                title = "HD Audio";
+                line1 = "Enables or disables the onboard HDA controller.";
+                line2 = "";
+                line3 = "";
+                action = "Press F10 to save, then reboot.";
+            } else if (adv->selected == 3) {
+                title = "CPU Turbo";
+                line1 = "Controls whether turbo boost is allowed.";
+                line2 = "";
+                line3 = "";
+                action = "Press F10 to save, then reboot.";
+            } else {
+                title = "VGA Mux";
+                line1 = "Routes the external VGA output.";
+                line2 = "Connector selects laptop VGA; Dock selects dock VGA.";
+                line3 = "";
+                action = "Press F10 to save, then reboot.";
+            }
+        } else if (menu == SETUP_MENU_BOOT) {
+            if (boot->selected == 0) {
+                title = "Boot Order";
+                line1 = "Selects the default SeaBIOS boot priority.";
+                line2 = "The boot menu can still override this at startup.";
+                line3 = "";
+                action = "Press F10 to save.";
+            } else if (boot->selected == 1) {
+                title = "Boot Prompt Delay";
+                line1 = "Controls how long SeaBIOS waits for hotkeys.";
+                line2 = "";
+                line3 = "";
+                action = "Press F10 to save.";
+            } else {
+                title = "USB Disk Mapping";
+                line1 = "Auto maps only selected USB boot device as fixed.";
+                line2 = "All maps every USB storage device as fixed.";
+                line3 = "Use Auto to avoid duplicate USB drives in Win98.";
+                action = "Press F10 to save.";
+            }
+        } else if (menu == SETUP_MENU_3DFX) {
+            if (!mxm->present) {
+                title = "3dfx MXM Card";
+                line1 = "No supported 3dfx MXM card was detected.";
+                line2 = "Card settings cannot be changed.";
+                line3 = "";
+            } else if (mxm->selected == 0) {
+                title = "Core Voltage";
+                line1 = "Sets the MXM card GPU core voltage.";
+                line2 = "This value is stored on the MXM card.";
+                line3 = "If video fails, spam R at boot to reset settings.";
+                action = "Press F10 to apply to the card.";
+            } else if (mxm->selected == 1) {
+                title = "Framebuffer Memory";
+                line1 = "Selects 32 MB or 64 MB framebuffer on M4800.";
+                line2 = "This value is stored on the MXM card.";
+                line3 = "Do not use 64 MB with Windows 98.";
+                action = "Press F10 to apply, then reboot.";
+            } else {
+                title = mxm->m4800 ? "VSA NT Blank Fix" : "Avenger Blank Fix";
+                line1 = mxm->m4800 ? "Needed for NT OSes: VSA driver shifts the image"
+                                   : "Required for Avenger and always enabled.";
+                line2 = mxm->m4800 ? "right by 4 pixels; onboard FPGA compensates."
+                                   : "This value is not user-selectable.";
+                line3 = mxm->m4800 ? "This value is stored on the MXM card." : "";
+                action = mxm->m4800 ? "Press F10 to apply to the card." : "";
+            }
+        } else if (menu == SETUP_MENU_PANEL) {
+            if (!mxm->present) {
+                title = "Panel and Scaler";
+                line1 = "No supported 3dfx MXM card was detected.";
+                line2 = "Panel settings cannot be changed.";
+                line3 = "";
+            } else if (mxm->panel_selected == 0) {
+                title = "Panel Backlight";
+                line1 = "Sets the MXM card panel backlight level.";
+                line2 = "This value is stored on the MXM card.";
+                line3 = "";
+                action = "Press F10 to apply to the card.";
+            } else if (mxm->panel_selected == 1) {
+                title = "Force 4:3 for DOS modes";
+                line1 = "Pillarboxes narrow DOS modes to their 4:3 shape";
+                line2 = "instead of stretching. SeaBIOS always stretches at";
+                line3 = "boot; this applies once the OS takes over.";
+                action = "Press F10 to apply to the card.";
+            } else if (mxm->panel_selected == 2) {
+                title = "Scaling Filter";
+                line1 = "Kernel used to upscale to the panel. Mitchell is a";
+                line2 = "good default; Keys sharper; Gaussian soft; Lanczos-2";
+                line3 = "sharpest (rings most). Stored on the MXM card.";
+                action = "Press F10 to apply to the card.";
+            } else if (mxm->panel_selected == 3 || mxm->panel_selected == 4) {
+                title = "Filter Parameter";
+                line1 = "Shapes the scaling filter; each family keeps its own.";
+                line2 = "Lower/negative = sharper with ringing; higher = softer.";
+                line3 = "PgUp/PgDn jump to the ends. Stored on the MXM card.";
+                action = "Press F10 to apply to the card.";
+            } else if (mxm->panel_selected == 5 || mxm->panel_selected == 6) {
+                title = mxm->panel_selected == 5 ? "Contrast" : "Edge Enhance";
+                line1 = "Adjusts the scaler image processing.";
+                line2 = "Contrast 0-100; Edge Enhance 0-30 (0 = off).";
+                line3 = "This value is stored on the MXM card.";
+                action = "Press F10 to apply to the card.";
+            } else {
+                title = "White Balance";
+                line1 = "Per-channel white balance, 0-100 (50 is neutral).";
+                line2 = "All three channels apply together.";
+                line3 = "This value is stored on the MXM card.";
+                action = "Press F10 to apply to the card.";
+            }
+        } else if (menu == SETUP_MENU_SAVE_EXIT) {
+            title = "Save and Exit";
+            line1 = "Select an action and press Enter or F10.";
+            line2 = "Saved setup changes take effect after reboot.";
+            line3 = "";
+        }
+    }
+
+    setup_help_popup(title, line1, line2, line3, action);
+    setup_draw_current_page(menu, focus, adv, boot, dt, mxm, save);
+}
+
+static void
+show_setup_screen(void)
+{
+    struct bregs br;
+    int menu = SETUP_MENU_INFO;
+    int focus = SETUP_FOCUS_MENU;
+    struct setup_advanced_state adv;
+    struct setup_boot_state boot;
+    struct setup_3dfx_state mxm;
+    struct setup_datetime_state dt;
+    struct setup_save_exit_state save;
+
+    wait_threads();
+    adv.sata_mode = setup_read_sata_mode();
+    adv.hda_disable = setup_read_hda_disable();
+    adv.turbo_disable = setup_read_turbo_disable();
+    adv.vga_mux = setup_read_vga_mux();
+    adv.sata2 = setup_read_sata2();
+    adv.selected = 0;
+    boot.boot_order = setup_read_boot_order();
+    boot.boot_delay = setup_read_boot_delay();
+    boot.usb_fixed_disk = setup_read_usb_fixed_disk();
+    boot.selected = 0;
+    setup_3dfx_init(&mxm);
+    setup_3dfx_read_settings(&mxm);
+    setup_panel_baseline_set(&mxm);   /* Apply diffs against what was read */
+    setup_read_datetime(&dt);
+    dt.selected = 0;
+    save.selected = 0;
+
+    memset(&br, 0, sizeof(br));
+    br.flags = F_IF;
+    br.ax = 0x0003;
+    call16_int(0x10, &br);
+
+    memset(&br, 0, sizeof(br));
+    br.flags = F_IF;
+    br.ax = 0x0600;
+    br.bh = 0x1f;
+    br.cx = 0x0000;
+    br.dx = 0x184f;
+    call16_int(0x10, &br);
+    setup_hide_cursor();
+
+    setup_puts_attr(1, 16, "Precision M4800 3dfx Edition - Setup Utility", SETUP_ATTR_TITLE);
+    setup_draw_box(2, 1, 23, 78, SETUP_ATTR_NORMAL);
+    setup_draw_hline(4, 2, 76, SETUP_ATTR_NORMAL);
+    setup_put_char_attr(4, 1, SETUP_BOX_LT, SETUP_ATTR_NORMAL);
+    setup_put_char_attr(4, 78, SETUP_BOX_RT, SETUP_ATTR_NORMAL);
+    setup_draw_current_page(menu, focus, &adv, &boot, &dt, &mxm, &save);
+    setup_puts(24, 0, "");
+
+    for (;;) {
+        int key = get_keystroke_full(1000);
+        int scan_code;
+
+        if (key < 0) {
+            if (menu == SETUP_MENU_MAIN && focus == SETUP_FOCUS_PAGE)
+                setup_draw_main_page(&dt, focus);
+            continue;
+        }
+
+        scan_code = key >> 8;
+        if (scan_code == SETUP_KEY_ESC)
+            setup_reboot();
+
+        if (scan_code == SETUP_KEY_F1) {
+            setup_show_current_help(menu, focus, &adv, &boot, &dt, &mxm, &save);
+            continue;
+        }
+
+        if (scan_code == SETUP_KEY_TAB) {
+            focus = SETUP_FOCUS_MENU;
+            menu = menu == SETUP_MENU_COUNT - 1 ? 0 : menu + 1;
+            setup_draw_current_page(menu, focus, &adv, &boot, &dt, &mxm, &save);
+            setup_clear_message();
+            continue;
+        }
+
+        if (focus == SETUP_FOCUS_MENU) {
+            if (scan_code == SETUP_KEY_LEFT || scan_code == SETUP_KEY_RIGHT) {
+                if (scan_code == SETUP_KEY_LEFT)
+                    menu = menu == 0 ? SETUP_MENU_COUNT - 1 : menu - 1;
+                else
+                    menu = menu == SETUP_MENU_COUNT - 1 ? 0 : menu + 1;
+                setup_draw_current_page(menu, focus, &adv, &boot, &dt, &mxm, &save);
+                setup_clear_message();
+            }
+            if (scan_code == SETUP_KEY_DOWN || scan_code == SETUP_KEY_ENTER) {
+                if (menu == SETUP_MENU_INFO)
+                    continue;
+                focus = SETUP_FOCUS_PAGE;
+                setup_draw_current_page(menu, focus, &adv, &boot, &dt, &mxm, &save);
+            }
+            continue;
+        }
+
+        if (menu == SETUP_MENU_MAIN) {
+            if (scan_code == SETUP_KEY_UP || scan_code == SETUP_KEY_DOWN) {
+                if (scan_code == SETUP_KEY_UP && dt.selected == 0) {
+                    focus = SETUP_FOCUS_MENU;
+                    setup_draw_current_page(menu, focus, &adv, &boot, &dt, &mxm, &save);
+                    continue;
+                }
+                if (scan_code == SETUP_KEY_UP)
+                    dt.selected = dt.selected == 0 ? 5 : dt.selected - 1;
+                else
+                    dt.selected = dt.selected == 5 ? 0 : dt.selected + 1;
+                setup_draw_main_page(&dt, focus);
+                setup_clear_message();
+                continue;
+            }
+            if (scan_code == SETUP_KEY_LEFT || scan_code == SETUP_KEY_RIGHT
+                || scan_code == SETUP_KEY_MINUS || scan_code == SETUP_KEY_PLUS
+                || scan_code == SETUP_KEY_ENTER) {
+                int increase = scan_code != SETUP_KEY_MINUS && scan_code != SETUP_KEY_LEFT;
+                if (dt.selected == 0)
+                    dt.hour = increase ? (dt.hour + 1) % 24 : (dt.hour == 0 ? 23 : dt.hour - 1);
+                else if (dt.selected == 1)
+                    dt.min = increase ? (dt.min + 1) % 60 : (dt.min == 0 ? 59 : dt.min - 1);
+                else if (dt.selected == 2)
+                    dt.sec = increase ? (dt.sec + 1) % 60 : (dt.sec == 0 ? 59 : dt.sec - 1);
+                else if (dt.selected == 3)
+                    dt.month = increase ? (dt.month == 12 ? 1 : dt.month + 1)
+                                        : (dt.month <= 1 ? 12 : dt.month - 1);
+                else if (dt.selected == 4)
+                    dt.day = increase ? (dt.day == 31 ? 1 : dt.day + 1)
+                                      : (dt.day <= 1 ? 31 : dt.day - 1);
+                else if (dt.selected == 5)
+                    dt.year = increase ? (dt.year < 2099 ? dt.year + 1 : dt.year)
+                                       : (dt.year > 2000 ? dt.year - 1 : dt.year);
+                setup_draw_main_page(&dt, focus);
+                continue;
+            }
+            if (scan_code == SETUP_KEY_F10) {
+                setup_write_datetime(&dt);
+                setup_draw_main_page(&dt, focus);
+                setup_message("Time and date saved.");
+            }
+            continue;
+        }
+
+        if (menu == SETUP_MENU_ADVANCED) {
+            if (scan_code == SETUP_KEY_UP || scan_code == SETUP_KEY_DOWN) {
+                if (scan_code == SETUP_KEY_UP && adv.selected == 0) {
+                    focus = SETUP_FOCUS_MENU;
+                    setup_draw_current_page(menu, focus, &adv, &boot, &dt, &mxm, &save);
+                    continue;
+                }
+                if (scan_code == SETUP_KEY_UP)
+                    adv.selected = adv.selected == 0 ? 4 : adv.selected - 1;
+                else
+                    adv.selected = adv.selected == 4 ? 0 : adv.selected + 1;
+                setup_draw_advanced_page(&adv, focus);
+                setup_clear_message();
+                continue;
+            }
+            if (scan_code == SETUP_KEY_LEFT || scan_code == SETUP_KEY_RIGHT
+                || scan_code == SETUP_KEY_MINUS || scan_code == SETUP_KEY_PLUS
+                || scan_code == SETUP_KEY_ENTER) {
+                if (adv.selected == 0) {
+                    if (scan_code == SETUP_KEY_LEFT || scan_code == SETUP_KEY_MINUS)
+                        adv.sata_mode = adv.sata_mode == 0 ? 2 : adv.sata_mode - 1;
+                    else
+                        adv.sata_mode = adv.sata_mode == 2 ? 0 : adv.sata_mode + 1;
+                } else if (adv.selected == 1) {
+                    if (adv.sata_mode == 1)
+                        adv.sata2 = !adv.sata2;
+                } else if (adv.selected == 2) {
+                    adv.hda_disable = !adv.hda_disable;
+                } else if (adv.selected == 3) {
+                    adv.turbo_disable = !adv.turbo_disable;
+                } else {
+                    adv.vga_mux = !adv.vga_mux;
+                }
+                setup_draw_advanced_page(&adv, focus);
+                if (adv.selected == 1 && adv.sata_mode != 1)
+                    setup_message("mSATA Controller requires IDE native mode.");
+            }
+            if (scan_code == SETUP_KEY_F9) {
+                setup_defaults(&adv, &boot);
+                setup_draw_advanced_page(&adv, focus);
+                setup_message("Setup defaults loaded. Press F10 to save changes.");
+            }
+            if (scan_code == SETUP_KEY_F10) {
+                setup_write_advanced(&adv);
+                setup_draw_advanced_page(&adv, focus);
+                setup_message("Saved. Press ESC to reboot and apply setup changes.");
+            }
+            continue;
+        }
+
+        if (menu == SETUP_MENU_BOOT) {
+            if (scan_code == SETUP_KEY_UP || scan_code == SETUP_KEY_DOWN) {
+                if (scan_code == SETUP_KEY_UP && boot.selected == 0) {
+                    focus = SETUP_FOCUS_MENU;
+                    setup_draw_current_page(menu, focus, &adv, &boot, &dt, &mxm, &save);
+                    continue;
+                }
+                if (scan_code == SETUP_KEY_UP)
+                    boot.selected = boot.selected == 0 ? 2 : boot.selected - 1;
+                else
+                    boot.selected = boot.selected == 2 ? 0 : boot.selected + 1;
+                setup_draw_boot_page(&boot, focus);
+                setup_clear_message();
+                continue;
+            }
+            if (scan_code == SETUP_KEY_LEFT || scan_code == SETUP_KEY_RIGHT
+                || scan_code == SETUP_KEY_MINUS || scan_code == SETUP_KEY_PLUS
+                || scan_code == SETUP_KEY_ENTER) {
+                if (boot.selected == 0) {
+                    if (scan_code == SETUP_KEY_LEFT || scan_code == SETUP_KEY_MINUS)
+                        boot.boot_order = boot.boot_order == 0 ? 3 : boot.boot_order - 1;
+                    else
+                        boot.boot_order = boot.boot_order == 3 ? 0 : boot.boot_order + 1;
+                } else if (boot.selected == 1) {
+                    if (scan_code == SETUP_KEY_LEFT || scan_code == SETUP_KEY_MINUS)
+                        boot.boot_delay = boot.boot_delay == 0 ? 3 : boot.boot_delay - 1;
+                    else
+                        boot.boot_delay = boot.boot_delay == 3 ? 0 : boot.boot_delay + 1;
+                } else {
+                    boot.usb_fixed_disk = !boot.usb_fixed_disk;
+                }
+                setup_draw_boot_page(&boot, focus);
+                continue;
+            }
+            if (scan_code == SETUP_KEY_F9) {
+                boot.boot_order = SETUP_BOOT_ORDER_DEFAULT;
+                boot.boot_delay = SETUP_BOOT_DELAY_DEFAULT;
+                boot.usb_fixed_disk = SETUP_USB_FIXED_DEFAULT;
+                setup_draw_boot_page(&boot, focus);
+                setup_message("Boot defaults loaded. Press F10 to save changes.");
+                continue;
+            }
+            if (scan_code == SETUP_KEY_F10) {
+                setup_write_boot(&boot);
+                setup_draw_boot_page(&boot, focus);
+                setup_message("Saved. Press ESC to reboot and apply setup changes.");
+                continue;
+            }
+            continue;
+        }
+
+        if (menu == SETUP_MENU_SAVE_EXIT) {
+            if (scan_code == SETUP_KEY_UP || scan_code == SETUP_KEY_DOWN) {
+                if (scan_code == SETUP_KEY_UP && save.selected == 0) {
+                    focus = SETUP_FOCUS_MENU;
+                    setup_draw_current_page(menu, focus, &adv, &boot, &dt, &mxm, &save);
+                    continue;
+                }
+                if (scan_code == SETUP_KEY_UP)
+                    save.selected = save.selected == 0 ? 3 : save.selected - 1;
+                else
+                    save.selected = save.selected == 3 ? 0 : save.selected + 1;
+                setup_draw_save_exit_page(&save, focus);
+                setup_clear_message();
+                continue;
+            }
+            if (scan_code == SETUP_KEY_F9) {
+                setup_defaults(&adv, &boot);
+                save.selected = 0;
+                setup_draw_save_exit_page(&save, focus);
+                setup_message("Setup defaults loaded. Select save to keep them.");
+                continue;
+            }
+            if (scan_code == SETUP_KEY_ENTER || scan_code == SETUP_KEY_F10) {
+                if (save.selected == 0) {
+                    setup_write_all(&adv, &boot, &dt);
+                    setup_reboot();
+                } else if (save.selected == 1) {
+                    setup_reboot();
+                } else if (save.selected == 2) {
+                    setup_defaults(&adv, &boot);
+                    save.selected = 0;
+                    setup_draw_save_exit_page(&save, focus);
+                    setup_message("Setup defaults loaded. Select save to keep them.");
+                } else {
+                    setup_3dfx_reset_defaults_and_reboot();
+                }
+                continue;
+            }
+            continue;
+        }
+
+        if (menu == SETUP_MENU_PANEL) {
+            int max_selected = 9;
+
+            if (scan_code == SETUP_KEY_UP || scan_code == SETUP_KEY_DOWN) {
+                if (scan_code == SETUP_KEY_UP && mxm.panel_selected == 0) {
+                    focus = SETUP_FOCUS_MENU;
+                    setup_draw_current_page(menu, focus, &adv, &boot, &dt, &mxm, &save);
+                    continue;
+                }
+                if (scan_code == SETUP_KEY_UP)
+                    mxm.panel_selected = mxm.panel_selected == 0
+                        ? max_selected : mxm.panel_selected - 1;
+                else
+                    mxm.panel_selected = mxm.panel_selected == max_selected
+                        ? 0 : mxm.panel_selected + 1;
+                setup_draw_panel_page(&mxm, focus);
+                setup_clear_message();
+                continue;
+            }
+
+            if (scan_code == SETUP_KEY_LEFT || scan_code == SETUP_KEY_RIGHT
+                || scan_code == SETUP_KEY_MINUS || scan_code == SETUP_KEY_PLUS
+                || scan_code == SETUP_KEY_ENTER) {
+                int increase = scan_code != SETUP_KEY_MINUS && scan_code != SETUP_KEY_LEFT;
+
+                if (mxm.present) {
+                    int fam = mxm.filter_family;
+                    switch (mxm.panel_selected) {
+                    case 0:
+                        if (increase && mxm.brightness < 100)
+                            mxm.brightness++;
+                        if (!increase && mxm.brightness > 10)
+                            mxm.brightness--;
+                        break;
+                    case 1:
+                        mxm.dos43 = !mxm.dos43;
+                        break;
+                    case 2:
+                        if (increase)
+                            mxm.filter_family = (fam + 1)
+                                % SETUP_FIR_FAM_COUNT;
+                        else
+                            mxm.filter_family = (fam + SETUP_FIR_FAM_COUNT - 1)
+                                % SETUP_FIR_FAM_COUNT;
+                        break;
+                    case 3:
+                        if (increase
+                            && mxm.filter_p1[fam] < setup_fir_p1_max(fam))
+                            mxm.filter_p1[fam]++;
+                        if (!increase && mxm.filter_p1[fam] > 0)
+                            mxm.filter_p1[fam]--;
+                        break;
+                    case 4:
+                        if (increase
+                            && mxm.filter_p2[fam] < setup_fir_p2_max(fam))
+                            mxm.filter_p2[fam]++;
