+static int
+setup_vbios_extract_revision(void *rom, char *buf, int len)
+{
+    static const char marker[] = "BIOS REV ";
+    int i;
+
+    for (i = 0; i < VSA_ROM_SIZE - sizeof(marker); i++) {
+        int j;
+
+        for (j = 0; j < sizeof(marker) - 1; j++) {
+            if (readb(rom + i + j) != marker[j])
+                break;
+        }
+        if (j == sizeof(marker) - 1) {
+            int out = 0;
+
+            i += sizeof(marker) - 1;
+            while (out < len - 1 && i < VSA_ROM_SIZE) {
+                u8 ch = readb(rom + i++);
+
+                if (ch <= ' ' || ch > '~')
+                    break;
+                buf[out++] = ch;
+            }
+            buf[out] = '\0';
+            return out ? 0 : -1;
+        }
+    }
+
+    return -1;
+}
+
+static void
+setup_3dfx_vbios_revision(char *buf, int len)
+{
+    u16 bdf;
+    u16 device;
+    u32 bar0;
+    u32 rom_orig;
+    u16 command_orig;
+    u32 misc0_orig;
+    u32 misc1_orig;
+    void *mmio;
+    void *rom;
+
+    strtcpy(buf, "Unknown", len);
+
+    if (setup_3dfx_find_gpu(&bdf, &device))
+        return;
+    if (device != TDFX_DEV_NAPALM && device != TDFX_DEV_NAPALM2)
+        return;
+
+    bar0 = pci_config_readl(bdf, PCI_BASE_ADDRESS_0) & ~0x0f;
+    if (!bar0)
+        return;
+
+    mmio = (void*)bar0;
+    rom = mmio + VSA_ROM_OFFSET;
+    command_orig = pci_config_readw(bdf, PCI_COMMAND);
+    rom_orig = pci_config_readl(bdf, PCI_ROM_ADDRESS);
+
+    pci_config_writew(bdf, PCI_COMMAND, command_orig | PCI_COMMAND_MEMORY);
+    pci_config_writel(bdf, PCI_ROM_ADDRESS, (bar0 + VSA_ROM_OFFSET)
+                      | PCI_ROM_ADDRESS_ENABLE);
+
+    misc0_orig = readl(mmio + VSA_MISC_INIT0);
+    misc1_orig = readl(mmio + VSA_MISC_INIT1);
+    writel(mmio + VSA_MISC_INIT0, misc0_orig & 0xbfffffff);
+    writel(mmio + VSA_MISC_INIT1, (misc1_orig & 0xfdffffff) | 0x10);
+    msleep(1);
+
+    if (readb(rom) == 0x55 && readb(rom + 1) == 0xaa)
+        setup_vbios_extract_revision(rom, buf, len);
+
+    writel(mmio + VSA_MISC_INIT0, misc0_orig);
+    writel(mmio + VSA_MISC_INIT1, misc1_orig);
+    pci_config_writel(bdf, PCI_ROM_ADDRESS, rom_orig);
+    pci_config_writew(bdf, PCI_COMMAND, command_orig);
+}
