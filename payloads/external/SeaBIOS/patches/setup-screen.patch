+static void
+setup_copy_line(char *dst, int dstlen, const char *src)
+{
+    int i;
+
+    for (i = 0; i < dstlen - 1 && src[i] && src[i] != '\n'; i++)
+        dst[i] = src[i];
+    dst[i] = '\0';
+}
