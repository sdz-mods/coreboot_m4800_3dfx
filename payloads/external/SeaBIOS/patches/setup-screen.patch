+static u8
+setup_bcd_to_bin(u8 val)
+{
+    return (val & 0x0f) + ((val >> 4) * 10);
+}
+
+static void
+setup_read_datetime(struct setup_datetime_state *dt)
+{
+    u8 status_b;
+    u8 year;
+    u8 century;
+
+    rtc_updating();
+    status_b = rtc_read(CMOS_STATUS_B);
+    dt->sec = rtc_read(CMOS_RTC_SECONDS);
+    dt->min = rtc_read(CMOS_RTC_MINUTES);
+    dt->hour = rtc_read(CMOS_RTC_HOURS);
+    dt->day = rtc_read(CMOS_RTC_DAY_MONTH);
+    dt->month = rtc_read(CMOS_RTC_MONTH);
+    year = rtc_read(CMOS_RTC_YEAR);
+    century = rtc_read(CMOS_CENTURY);
+
+    if (!(status_b & RTC_B_BIN)) {
+        dt->sec = setup_bcd_to_bin(dt->sec);
+        dt->min = setup_bcd_to_bin(dt->min);
+        dt->hour = setup_bcd_to_bin(dt->hour);
+        dt->day = setup_bcd_to_bin(dt->day);
+        dt->month = setup_bcd_to_bin(dt->month);
+        year = setup_bcd_to_bin(year);
+        century = setup_bcd_to_bin(century);
+    }
+
+    dt->year = (century * 100) + year;
+}
+
+static u8
+setup_bin_to_bcd(u8 val)
+{
+    return ((val / 10) << 4) | (val % 10);
+}
+
+static void
+setup_write_datetime(const struct setup_datetime_state *dt)
+{
+    u8 status_b = rtc_read(CMOS_STATUS_B);
+    u8 sec = dt->sec;
+    u8 min = dt->min;
+    u8 hour = dt->hour;
+    u8 day = dt->day;
+    u8 month = dt->month;
+    u8 year = dt->year % 100;
+    u8 century = dt->year / 100;
+
+    if (!(status_b & RTC_B_BIN)) {
+        sec = setup_bin_to_bcd(sec);
+        min = setup_bin_to_bcd(min);
+        hour = setup_bin_to_bcd(hour);
+        day = setup_bin_to_bcd(day);
+        month = setup_bin_to_bcd(month);
+        year = setup_bin_to_bcd(year);
+        century = setup_bin_to_bcd(century);
+    }
+
+    rtc_mask(CMOS_STATUS_B, 0, RTC_B_SET);
+    rtc_write(CMOS_RTC_SECONDS, sec);
+    rtc_write(CMOS_RTC_MINUTES, min);
+    rtc_write(CMOS_RTC_HOURS, hour);
+    rtc_write(CMOS_RTC_DAY_MONTH, day);
+    rtc_write(CMOS_RTC_MONTH, month);
+    rtc_write(CMOS_RTC_YEAR, year);
+    rtc_write(CMOS_CENTURY, century);
+    rtc_mask(CMOS_STATUS_B, RTC_B_SET, 0);
+}
+
+static u8
+setup_cmos_read(u8 index)
+{
+    outb(index | 0x80, 0x70);
+    return inb(0x71);
+}
+
+static void
+setup_cmos_write(u8 index, u8 value)
+{
+    outb(index | 0x80, 0x70);
+    outb(value, 0x71);
+}
+
+static void
+setup_cmos_update_checksum(void)
+{
+    u16 sum = 0;
+    u8 i;
+
+    for (i = SETUP_CMOS_CSUM_START; i <= SETUP_CMOS_CSUM_END; i++)
+        sum += setup_cmos_read(i);
+
+    setup_cmos_write(SETUP_CMOS_CSUM_HIGH, sum >> 8);
+    setup_cmos_write(SETUP_CMOS_CSUM_LOW, sum & 0xff);
+}
+
+static u8
+setup_read_sata_mode(void)
+{
+    u8 mode = setup_cmos_read(SETUP_CMOS_SATA_MODE) & 0x03;
+
+    if (mode > 2)
+        mode = 2;
+
+    return mode;
+}
+
+static u8
+setup_read_hda_disable(void)
+{
+    return (setup_cmos_read(SETUP_CMOS_HDA_DISABLE) >> 2) & 0x01;
+}
+
+static u8
+setup_read_turbo_disable(void)
+{
+    return (setup_cmos_read(SETUP_CMOS_TURBO_DISABLE) >> 3) & 0x01;
+}
+
+static u8
+setup_read_vga_mux(void)
+{
+    return (setup_cmos_read(SETUP_CMOS_VGA_MUX) >> 4) & 0x01;
+}
+
+static u8
+setup_read_sata2(void)
+{
+    return (setup_cmos_read(SETUP_CMOS_SATA2) >> 7) & 0x01;
+}
+
+static u8
+setup_read_boot_order(void)
+{
+    return (setup_cmos_read(SETUP_CMOS_BOOT_ORDER) >> 5) & 0x03;
+}
+
+static u8
+setup_read_boot_delay(void)
+{
+    return (setup_cmos_read(SETUP_CMOS_BOOT_DELAY) >> 3) & 0x03;
+}
+
+static void
+setup_write_sata_mode(u8 mode)
+{
+    u8 value = setup_cmos_read(SETUP_CMOS_SATA_MODE);
+
+    value = (value & ~0x03) | (mode & 0x03);
+    setup_cmos_write(SETUP_CMOS_SATA_MODE, value);
+}
+
+static void
+setup_write_hda_disable(u8 disable)
+{
+    u8 value = setup_cmos_read(SETUP_CMOS_HDA_DISABLE);
+
+    value = (value & ~0x04) | ((disable & 0x01) << 2);
+    setup_cmos_write(SETUP_CMOS_HDA_DISABLE, value);
+}
+
+static void
+setup_write_turbo_disable(u8 disable)
+{
+    u8 value = setup_cmos_read(SETUP_CMOS_TURBO_DISABLE);
+
+    value = (value & ~0x08) | ((disable & 0x01) << 3);
+    setup_cmos_write(SETUP_CMOS_TURBO_DISABLE, value);
+}
+
+static void
+setup_write_vga_mux(u8 target)
+{
+    u8 value = setup_cmos_read(SETUP_CMOS_VGA_MUX);
+
+    value = (value & ~0x10) | ((target & 0x01) << 4);
+    setup_cmos_write(SETUP_CMOS_VGA_MUX, value);
+}
+
+static void
+setup_write_sata2(u8 enable)
+{
+    u8 value = setup_cmos_read(SETUP_CMOS_SATA2);
+
+    value = (value & ~0x80) | ((enable & 0x01) << 7);
+    setup_cmos_write(SETUP_CMOS_SATA2, value);
+}
+
+static void
+setup_write_boot_order(u8 order)
+{
+    u8 value = setup_cmos_read(SETUP_CMOS_BOOT_ORDER);
+
+    value = (value & ~0x60) | ((order & 0x03) << 5);
+    setup_cmos_write(SETUP_CMOS_BOOT_ORDER, value);
+}
+
+static void
+setup_write_boot_delay(u8 delay)
+{
+    u8 value = setup_cmos_read(SETUP_CMOS_BOOT_DELAY);
+
+    value = (value & ~0x18) | ((delay & 0x03) << 3);
+    setup_cmos_write(SETUP_CMOS_BOOT_DELAY, value);
+}
+
+static void
+setup_write_advanced(const struct setup_advanced_state *adv)
+{
+    setup_write_sata_mode(adv->sata_mode);
+    setup_write_hda_disable(adv->hda_disable);
+    setup_write_turbo_disable(adv->turbo_disable);
+    setup_write_vga_mux(adv->vga_mux);
+    setup_write_sata2(adv->sata2);
+    setup_cmos_update_checksum();
+}
+
+static void
+setup_write_boot(const struct setup_boot_state *boot)
+{
+    setup_write_boot_order(boot->boot_order);
+    setup_write_boot_delay(boot->boot_delay);
+    setup_cmos_update_checksum();
+}
