+static int
+kbd_wait_for_write(void)
+{
+    int i;
+
+    for (i = 0; i < 10000; i++) {
+        if (!(inb(PORT_PS2_STATUS) & I8042_STR_IBF))
+            return 0;
+        udelay(50);
+    }
+
+    return -1;
+}
+
+static int
+kbd_write_leds(u8 led_flags)
+{
+    /*
+     * Some EC-backed keyboards accept the LED command bytes but do not
+     * reliably complete SeaBIOS' ACK-driven ps2_kbd_command() sequence.
+     * Write the same byte stream that works from DOS debug:
+     *   out 0x60, 0xed; out 0x60, led_flags
+     */
+    if (kbd_wait_for_write())
+        return -1;
+    outb((u8)ATKBD_CMD_SETLEDS, PORT_PS2_DATA);
+    if (kbd_wait_for_write())
+        return -1;
+    outb(led_flags, PORT_PS2_DATA);
+
+    return 0;
+}
+
 static void noinline
 set_leds(void)
 {
@@ -233,14 +267,21 @@ set_leds(void)
     if (shift_flags == led_flags)
         return;
 
-    int ret = kbd_command(ATKBD_CMD_SETLEDS, &shift_flags);
+    int ret = kbd_write_leds(shift_flags);
     if (ret)
         // Error
         return;
     kbd_led = (kbd_led & ~0x07) | shift_flags;
     SET_BDA(kbd_led, kbd_led);
 }
 
+static void
+set_leds_on_press(int key_release)
+{
+    if (!key_release)
+        set_leds();
+}
