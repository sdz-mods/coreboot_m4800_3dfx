# -----------------------------------------------------------------
entries

# -----------------------------------------------------------------
0	120	r	0	reserved_memory

# -----------------------------------------------------------------
# RTC_BOOT_BYTE (coreboot hardcoded)
384	1	e	4	boot_option
388	4	h	0	reboot_counter

# -----------------------------------------------------------------
# Bytes 49-50 (bits 392-407) must stay outside the checksummed range:
# byte 50 is the legacy CMOS century location (offset 0x32), which
# legacy OSes write directly on RTC updates regardless of the FADT.
# A checksummed option there would be invalidated by every such write,
# resetting all setup options to defaults on the next boot.
#392	8	r	0	unused
#400	8	r	0	century byte, written by legacy OSes

# coreboot config options: console
432	4	e	6	debug_level

# coreboot config options: EC
412	1	e	1	bluetooth
413	1	e	1	wwan
415	1	e	1	wlan

# coreboot config options: SATA
416	2	e	15	sata_mode
418	1	e	1	hda_disable
419	1	e	1	turbo_disable
420	1	e	16	vga_mux
421	2	e	17	boot_order
423	1	e	1	sata2
427	2	e	18	boot_delay

# coreboot config options: dock Super I/O (LPC47N237)
# dock_superio uses the last free bit in the checksummed range (byte 51 bit 6).
# dock_smm has no room left there, so it sits in the RTC boot byte (byte 48
# bit 1); the boot logic only touches bit 0 and bits 4-7, so bits 1-3 survive.
414	1	e	1	dock_superio
385	1	e	1	dock_smm
429	3	e	19	com_port
436	2	e	22	lpt_port
438	2	e	20	lpt_mode

# coreboot config options: ME
424	1	e	14	me_state
425	2	h	0	me_state_prev

# coreboot config options: southbridge
408	1	e	1	nmi
409	2	e	7	power_on_after_fail

# coreboot config options: northbridge
440	8	h	0	volume

# Bytes 56-71 (bits 448-575): formerly reserved for vboot's vbnv (vboot is
# not used on this board). Now inside the extended checksum range; keep
# reserved so future options prefer the fresh space at byte 72 onward.
448	128	r	0	unused_vbnv

# coreboot config options: CPU (byte 72+)
576	3	e	23	cpu_clock_cap
579	1	e	1	hyperthreading
580	2	e	24	cpu_cores
582	1	e	1	cpu_cache

# coreboot config options: check sums
984	16	h	0	check_sum

