boot_option=Fallback
debug_level=Debug
power_on_after_fail=Disable
nmi=Enable
volume=0x3
bluetooth=Enable
wwan=Enable
wlan=Enable
sata_mode=IDE_Native
sata2=Enable
hda_disable=Disable
turbo_disable=Disable
vga_mux=VGA
boot_order=HDD_CD_USB_Payload
boot_delay=5_sec
me_state=Normal
dock_superio=Disable
dock_smm=Enable
com_port=COM1_3F8_IRQ4
lpt_port=LPT1_378_polled
lpt_mode=PS2
cpu_clock_cap=Off
hyperthreading=Enable
cpu_cores=All
